<%
  const user = session.authenticatedUser;
  const isMember = user.role === 'user';
%>

<section class="mb-6 p-6 border border-slate-200 rounded-2xl bg-gradient-to-br from-white to-slate-50 shadow-lg">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-blue-600 mb-1">
        <%= isMember ? 'Member' : user.role === 'admin' ? 'Admin' : 'Organizer' %>
      </p>
      <h1 class="text-3xl font-bold text-slate-900 mb-1">Welcome back, <%= user.displayName %>.</h1>
      <p class="text-slate-500">
        <% if (isMember) { %>
          Browse upcoming events or check in on your RSVPs below.
        <% } else { %>
          Here's a summary of your events. Head to your dashboard for full controls.
        <% } %>
      </p>
    </div>
  </div>
</section>

<% if (isMember) { %>
  <%
    const upcomingCount = upcoming.length;
    const historyCount = history.length;
  %>

  <div class="grid grid-cols-2 gap-4 mb-6">
    <div class="p-5 border border-slate-200 rounded-2xl bg-white shadow-sm">
      <p class="text-2xl font-bold text-slate-900"><%= upcomingCount %></p>
      <p class="text-sm text-slate-500 mt-0.5">Upcoming RSVP<%= upcomingCount !== 1 ? 's' : '' %></p>
    </div>
    <div class="p-5 border border-slate-200 rounded-2xl bg-white shadow-sm">
      <p class="text-2xl font-bold text-slate-900"><%= historyCount %></p>
      <p class="text-sm text-slate-500 mt-0.5">Past event<%= historyCount !== 1 ? 's' : '' %></p>
    </div>
  </div>

  <section class="mb-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-semibold text-slate-800">Your upcoming events</h2>
      <% if (upcomingCount > 3) { %>
        <a href="/my-rsvps" class="text-sm text-blue-600 hover:underline">View all</a>
      <% } %>
    </div>

    <% if (upcomingCount === 0) { %>
      <div class="p-8 border border-dashed border-slate-300 rounded-2xl bg-white text-center">
        <p class="text-slate-400 mb-4">You haven't RSVPed to any upcoming events.</p>
        <a href="/events" class="inline-block px-4 py-2.5 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors">Browse events</a>
      </div>
    <% } else { %>
      <div class="grid gap-3">
        <% upcoming.slice(0, 3).forEach(({ event, rsvp }) => { %>
          <a href="/events/<%= event.id %>" class="block p-4 border border-slate-200 rounded-2xl bg-white shadow-sm hover:shadow-md hover:border-blue-200 transition-all no-underline">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="font-semibold text-slate-900 truncate"><%= event.title %></p>
                <p class="text-sm text-slate-500 mt-0.5">
                  <%= event.startDatetime.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %>
                  · <%= event.location %>
                </p>
              </div>
              <% if (rsvp.status === 'waitlisted') { %>
                <span class="shrink-0 text-xs font-medium px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 border border-amber-200">Waitlisted</span>
              <% } else { %>
                <span class="shrink-0 text-xs font-medium px-2.5 py-1 rounded-full bg-green-50 text-green-700 border border-green-200">Going</span>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <div class="flex flex-wrap gap-3">
    <a href="/events" class="px-4 py-2.5 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors no-underline">Browse events</a>
    <a href="/my-rsvps" class="px-4 py-2.5 rounded-lg bg-white text-slate-700 border border-slate-200 text-sm font-medium hover:bg-slate-50 transition-colors no-underline">My RSVPs</a>
  </div>

<% } else { %>
  <%
    const publishedCount = groups.published.length;
    const draftCount = groups.draft.length;
    const archivedCount = groups.archived.length;
    const totalAttendees = groups.published.reduce((sum, e) => sum + e.attendeeCount, 0);
  %>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="p-5 border border-slate-200 rounded-2xl bg-white shadow-sm">
      <p class="text-2xl font-bold text-slate-900"><%= publishedCount %></p>
      <p class="text-sm text-slate-500 mt-0.5">Published</p>
    </div>
    <div class="p-5 border border-slate-200 rounded-2xl bg-white shadow-sm">
      <p class="text-2xl font-bold text-slate-900"><%= draftCount %></p>
      <p class="text-sm text-slate-500 mt-0.5">Draft</p>
    </div>
    <div class="p-5 border border-slate-200 rounded-2xl bg-white shadow-sm">
      <p class="text-2xl font-bold text-slate-900"><%= archivedCount %></p>
      <p class="text-sm text-slate-500 mt-0.5">Archived</p>
    </div>
    <div class="p-5 border border-blue-100 rounded-2xl bg-blue-50 shadow-sm">
      <p class="text-2xl font-bold text-blue-700"><%= totalAttendees %></p>
      <p class="text-sm text-blue-600 mt-0.5">Total attendees</p>
    </div>
  </div>

  <section class="mb-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-semibold text-slate-800">Published events</h2>
      <a href="/dashboard" class="text-sm text-blue-600 hover:underline">Full dashboard</a>
    </div>

    <% if (publishedCount === 0) { %>
      <div class="p-8 border border-dashed border-slate-300 rounded-2xl bg-white text-center">
        <p class="text-slate-400 mb-4">No published events yet.</p>
        <a href="/events/new" class="inline-block px-4 py-2.5 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors">Create your first event</a>
      </div>
    <% } else { %>
      <div class="grid gap-3">
        <% groups.published.slice(0, 3).forEach((event) => { %>
          <a href="/events/<%= event.id %>" class="block p-4 border border-slate-200 rounded-2xl bg-white shadow-sm hover:shadow-md hover:border-blue-200 transition-all no-underline">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="font-semibold text-slate-900 truncate"><%= event.title %></p>
                <p class="text-sm text-slate-500 mt-0.5">
                  <%= event.startDatetime.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %>
                  · <%= event.location %>
                </p>
              </div>
              <div class="shrink-0 text-right">
                <p class="text-sm font-semibold text-slate-700">
                  <%= event.attendeeCount %><% if (event.capacity) { %>/<%= event.capacity %><% } %>
                </p>
                <p class="text-xs text-slate-400">attendees</p>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <div class="flex flex-wrap gap-3">
    <a href="/dashboard" class="px-4 py-2.5 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors no-underline">Event dashboard</a>
    <a href="/events/new" class="px-4 py-2.5 rounded-lg bg-white text-slate-700 border border-slate-200 text-sm font-medium hover:bg-slate-50 transition-colors no-underline">Create new event</a>
  </div>

<% } %>
