<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Project Starter</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script>
      // Manual test checklist for relativeTime(isoString, nearLabel):
      // - Past event (startDatetime in the past)      → no label shown
      // - Event starting within 60 min               → "starting soon" / "ending soon"
      // - Event starting later today (> 60 min away) → "today"
      // - Event starting tomorrow                    → "tomorrow"
      // - Event starting in 3 days                   → "in 3 days"
      // - Event starting in 8+ days                  → no label shown
      // - End date within 60 min of now              → "ending soon"
      function relativeTime(isoString, nearLabel = "starting soon") {
        return {
          label: "",
          init() {
            const target = new Date(isoString);
            const now = new Date();
            const diffMs = target - now;
            const diffMins = Math.round(diffMs / 60000);
            const diffHours = Math.round(diffMs / 3600000);
            const diffDays = Math.round(diffMs / 86400000);

            const sameDay =
              target.getFullYear() === now.getFullYear() &&
              target.getMonth() === now.getMonth() &&
              target.getDate() === now.getDate();

            if (diffMs < 0) {
              this.label = "";
            } else if (diffMins < 60) {
              this.label = nearLabel;
            } else if (sameDay) {
              this.label = "today";
            } else if (diffHours < 24) {
              this.label = diffHours === 1 ? "in 1 hour" : `in ${diffHours} hours`;
            } else if (diffDays === 1) {
              this.label = "tomorrow";
            } else if (diffDays < 7) {
              this.label = `in ${diffDays} days`;
            } else {
              this.label = "";
            }
          },
        };
      }
    </script>
  </head>
  <body class="min-h-screen bg-gradient-to-b from-slate-50 to-slate-100 text-slate-900 p-6">
    <div class="max-w-5xl mx-auto">
      <nav class="flex items-center justify-between gap-3 mb-6 flex-wrap">
        <a
          href="<%= session?.authenticatedUser ? '/home' : '/login' %>"
          class="inline-flex items-center gap-2.5 px-4 py-3 rounded-xl bg-white border border-slate-200 shadow-lg font-bold text-slate-900 no-underline"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-b from-blue-400 to-blue-600"></span>
          Project Starter
        </a>
        <div class="flex items-center gap-3 flex-wrap">
          <% if (session?.authenticatedUser) { %>
            <% if (session.authenticatedUser.role === "admin") { %>
              <a href="/admin/users" class="text-blue-700 font-semibold no-underline hover:underline">Manage Users</a>
            <% } %>
            <span class="text-slate-500">
              Signed in as <strong class="text-slate-700"><%= session.authenticatedUser.displayName %></strong>
              (<%= session.authenticatedUser.role %>)
            </span>
            <form method="post" action="/logout" class="m-0">
              <button
                type="submit"
                class="px-3.5 py-2 rounded-lg bg-white text-blue-700 border border-slate-200 cursor-pointer hover:bg-blue-50 text-sm font-medium"
              >
                Log out
              </button>
            </form>
          <% } else { %>
            <a href="/login" class="text-blue-700 font-semibold no-underline hover:underline">Log in</a>
          <% } %>
        </div>
      </nav>
      <main class="max-w-5xl mx-auto"><%- body %></main>
    </div>
  </body>
</html>
