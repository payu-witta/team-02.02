<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-1">My RSVPs</h1>
  <p class="text-slate-500">Track your upcoming and past events.</p>
</section>

<div class="grid gap-5 lg:grid-cols-2 items-start">
    <% const groups = {
    upcoming: upcoming,
    history: history
    }; %>

    <% const statusGroups = [
      { key: 'upcoming', label: 'Upcoming', color: 'text-blue-700', bg: 'bg-blue-50/50', border: 'border-blue-100' },
      { key: 'history', label: 'History', color: 'text-slate-700', bg: 'bg-slate-50/50', border: 'border-slate-100' }
    ]; %>

  <% statusGroups.forEach(group => { %>
    <section 
      class="p-5 border <%= group.border %> rounded-2xl <%= group.bg %> shadow-sm transition-all min-h-[160px] flex flex-col"
    >
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold <%= group.color %> uppercase tracking-tight">
          <%= group.label %> 
          <span class="ml-1 text-sm font-normal opacity-60">(<%= groups[group.key].length %>)</span>
        </h2>
      </div>
      
      <div>
        <% if (groups[group.key].length === 0) { %>
          <p class="text-sm text-slate-400 italic py-4">No events in this category.</p>
        <% } else { %>
          <ul class="space-y-3">
            <% groups[group.key].forEach(({ event, rsvp }) => { %>
              <li id="rsvp-row-<%= event.id %>" class="p-4 border border-slate-200 rounded-xl bg-white shadow-sm">
                <div class="flex items-center justify-between gap-4">
                  <div>
                    <p class="font-semibold text-slate-900"><%= event.title %></p>
                    <p class="text-sm text-slate-500"><%= event.startDatetime.toLocaleString() %></p>
                  </div>

                  <span class="capitalize px-3 py-1 rounded-full text-xs font-semibold
                    <%= rsvp.status === 'waitlisted'
                      ? 'bg-amber-100 text-amber-800'
                      : rsvp.status === 'cancelled'
                      ? 'bg-slate-200 text-slate-700'
                      : 'bg-blue-100 text-blue-800' %>">
                    <%= rsvp.status %>
                  </span>
                </div>

                <% if (group.key === 'upcoming') { %>
                  <form
                    class="mt-3"
                    x-data
                    x-on:submit="if (!confirm('Are you sure you want to cancel this RSVP?')) $event.preventDefault()"
                    hx-post="/events/<%= event.id %>/rsvp"
                    hx-target="#rsvp-row-<%= event.id %>"
                    hx-swap="delete"
                  >
                    <button
                      type="submit"
                      class="px-3 py-2 rounded-lg bg-slate-700 text-sm font-semibold text-white hover:bg-slate-800"
                    >
                      <%= rsvp.status === 'waitlisted' ? 'Leave Waitlist' : 'Cancel RSVP' %>
                    </button>
                  </form>
                <% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </section>
  <% }) %>
</div>