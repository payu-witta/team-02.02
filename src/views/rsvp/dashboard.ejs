<h1>My RSVPs</h1>

<h2>Going</h2>
<% if (going.length === 0) { %>
  <p>No RSVPs</p>
<% } %>

<% going.forEach(({ event }) => { %>
  <p><%= event.title %></p>
<% }) %>

<h2>Not Going</h2>
<% if (notgoing.length === 0) { %>
  <p>No RSVPs</p>
<% } %>

<% notgoing.forEach(({ event }) => { %>
  <p><%= event.title %></p>
<% }) %>