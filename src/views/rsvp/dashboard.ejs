<h1>My RSVPs</h1>

<h2>upcoming</h2>
<% if (upcoming.length === 0) { %>
  <p>No RSVPs</p>
<% } %>

<% upcoming.forEach(({ event }) => { %>
  <p><%= event.title %></p>
<% }) %>

<h2>history</h2>
<% if (history.length === 0) { %>
  <p>No RSVPs</p>
<% } %>

<% history.forEach(({ event }) => { %>
  <p><%= event.title %></p>
<% }) %>