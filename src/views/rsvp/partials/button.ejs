<div
  id="rsvp-button-<%= eventId %>"
  x-data="{ visible: false }"
  x-init="$nextTick(() => { visible = true })"
>
  <div
    x-show="visible"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 translate-y-1"
    x-transition:enter-end="opacity-100 translate-y-0"
  >
  <div id="rsvp-error-<%= eventId %>"></div>

  <% if (!rsvp || rsvp.status === "cancelled") { %>
    <form
      hx-post="/events/<%= eventId %>/rsvp"
      hx-target="#rsvp-button-<%= eventId %>"
      hx-swap="outerHTML"
      hx-disabled-elt="find button"
      hx-on:htmx:response-error="document.getElementById('rsvp-error-<%= eventId %>').innerHTML = event.detail.xhr.responseText"
    >
      <button
        type="submit"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 text-white font-semibold text-sm shadow-sm hover:bg-blue-700 active:scale-95 transition-all cursor-pointer disabled:opacity-50 disabled:cursor-wait disabled:scale-100"
      >
        RSVP to this event
      </button>
    </form>

  <% } else if (rsvp.status === "going") { %>
    <div class="flex items-center gap-3 flex-wrap">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-green-50 text-green-800 text-sm font-semibold border border-green-200">
        <span class="w-2 h-2 rounded-full bg-green-500"></span>
        You're going!
      </span>
      <form
        hx-post="/events/<%= eventId %>/rsvp"
        hx-target="#rsvp-button-<%= eventId %>"
        hx-swap="outerHTML"
        hx-disabled-elt="find button"
        hx-on:htmx:response-error="document.getElementById('rsvp-error-<%= eventId %>').innerHTML = event.detail.xhr.responseText"
      >
        <button
          type="submit"
          class="px-4 py-2 rounded-xl bg-white text-slate-600 border border-slate-200 font-medium text-sm hover:bg-red-50 hover:text-red-600 hover:border-red-200 active:scale-95 transition-all cursor-pointer disabled:opacity-50 disabled:cursor-wait disabled:scale-100"
        >
          Cancel RSVP
        </button>
      </form>
    </div>

  <% } else if (rsvp.status === "waitlisted") { %>
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-3 flex-wrap">
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-amber-50 text-amber-800 text-sm font-semibold border border-amber-200">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          On waitlist
        </span>
        <form
          hx-post="/events/<%= eventId %>/rsvp"
          hx-target="#rsvp-button-<%= eventId %>"
          hx-swap="outerHTML"
          hx-disabled-elt="find button"
          hx-on:htmx:response-error="document.getElementById('rsvp-error-<%= eventId %>').innerHTML = event.detail.xhr.responseText"
        >
          <button
            type="submit"
            class="px-4 py-2 rounded-xl bg-white text-slate-600 border border-slate-200 font-medium text-sm hover:bg-slate-50 active:scale-95 transition-all cursor-pointer disabled:opacity-50 disabled:cursor-wait disabled:scale-100"
          >
            Leave Waitlist
          </button>
        </form>
      </div>
      <% if (waitlistPosition !== null) { %>
        <div
          role="status"
          aria-label="Waitlist position #<%= waitlistPosition %>"
          class="inline-flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white border border-amber-300 shadow-sm"
        >
          <div class="flex items-center justify-center w-9 h-9 rounded-full bg-amber-500 text-white font-bold text-base flex-shrink-0 <%= waitlistPosition === 1 ? 'ring-2 ring-amber-300 ring-offset-1 animate-pulse' : '' %>">
            <%= waitlistPosition %>
          </div>
          <div class="leading-tight">
            <p class="text-xs font-semibold text-amber-700 uppercase tracking-wide">Queue Position</p>
            <p class="text-sm text-slate-700 font-medium">
              <% if (waitlistPosition === 1) { %>
                You're next in line!
              <% } else { %>
                <%= waitlistPosition - 1 %> <%= waitlistPosition - 1 === 1 ? 'person' : 'people' %> ahead of you
              <% } %>
            </p>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
  </div>
</div>
