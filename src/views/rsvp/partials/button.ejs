<div id="rsvp-button-<%= eventId %>">
  <div id="rsvp-error-<%= eventId %>"></div>
  <% if (!rsvp || rsvp.status === "cancelled") { %>
    <form
      hx-post="/events/<%= eventId %>/rsvp"
      hx-target="#rsvp-button-<%= eventId %>"
      hx-swap="outerHTML"
    >
      <button
        type="submit"
        class="px-4 py-2 rounded-lg bg-blue-600 text-white font-medium text-sm cursor-pointer hover:bg-blue-700"
      >
        RSVP
      </button>
    </form>
  <% } else if (rsvp.status === "going") { %>
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-100 text-green-800 text-sm font-medium">
        <span class="w-2 h-2 rounded-full bg-green-500"></span>
        Going
      </span>
      <form
        hx-post="/events/<%= eventId %>/rsvp"
        hx-target="#rsvp-button-<%= eventId %>"
        hx-swap="outerHTML"
      >
        <button
          type="submit"
          class="px-4 py-2 rounded-lg bg-white text-slate-700 border border-slate-200 font-medium text-sm cursor-pointer hover:bg-slate-50"
        >
          Cancel RSVP
        </button>
      </form>
    </div>
  <% } else if (rsvp.status === "waitlisted") { %>
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-yellow-100 text-yellow-800 text-sm font-medium">
        <span class="w-2 h-2 rounded-full bg-yellow-500"></span>
        Waitlisted<% if (waitlistPosition !== null) { %> #<%= waitlistPosition %><% } %>
      </span>
      <form
        hx-post="/events/<%= eventId %>/rsvp"
        hx-target="#rsvp-button-<%= eventId %>"
        hx-swap="outerHTML"
      >
        <button
          type="submit"
          class="px-4 py-2 rounded-lg bg-white text-slate-700 border border-slate-200 font-medium text-sm cursor-pointer hover:bg-slate-50"
        >
          Leave Waitlist
        </button>
      </form>
    </div>
  <% } %>
</div>
