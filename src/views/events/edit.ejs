<% if (!event) { %>
  <%- include("../partials/error", { message: "Event could not be loaded." }) %>
<% } else { %>

<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-1">Edit Event</h1>
  <p class="text-slate-500">Update the details below. Changes will be saved to the draft.</p>
</section>

<div id="edit-form-section">

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<section class="max-w-2xl p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
  <form
    class="grid gap-4"
    method="post"
    action="/events/<%= event.id %>/edit"
    hx-post="/events/<%= event.id %>/edit"
    hx-target="#edit-form-section"
    hx-swap="outerHTML"
    x-data="{
      isDirty: false,
      snapshot: {},
      init() {
        const fields = this.$el.querySelectorAll('input, textarea, select');
        fields.forEach(f => { this.snapshot[f.name] = f.value; });
        this.$el.addEventListener('input', () => this.checkDirty());
        this.$el.addEventListener('change', () => this.checkDirty());
      },
      checkDirty() {
        const fields = this.$el.querySelectorAll('input, textarea, select');
        this.isDirty = Array.from(fields).some(f => f.value !== this.snapshot[f.name]);
      },
      submit() {
        this.isDirty = false;
      }
    }"
    x-on:submit="submit"
    x-on:beforeunload.window="if (isDirty) $event.preventDefault()"
  >

    <div
      x-show="isDirty"
      x-cloak
      class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 text-sm font-medium"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
      </svg>
      You have unsaved changes
    </div>

    <div class="grid gap-1.5">
      <label for="title" class="text-sm font-medium">Title <span class="text-red-500">*</span></label>
      <input
        id="title"
        name="title"
        type="text"
        required
        maxlength="100"
        value="<%= event.title %>"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      />
    </div>

    <div class="grid gap-1.5">
      <label for="description" class="text-sm font-medium">Description <span class="text-red-500">*</span></label>
      <textarea
        id="description"
        name="description"
        rows="4"
        required
        maxlength="1000"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500 resize-y"
      ><%= event.description %></textarea>
    </div>

    <div class="grid gap-1.5">
      <label for="location" class="text-sm font-medium">Location <span class="text-red-500">*</span></label>
      <input
        id="location"
        name="location"
        type="text"
        required
        value="<%= event.location %>"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      />
    </div>

    <div class="grid gap-1.5">
      <label for="category" class="text-sm font-medium">Category <span class="text-red-500">*</span></label>
      <select
        id="category"
        name="category"
        required
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      >
        <option value="social"    <%= event.category === "social"      ? "selected" : "" %>>Social</option>
        <option value="educational" <%= event.category === "educational" ? "selected" : "" %>>Educational</option>
        <option value="volunteer" <%= event.category === "volunteer"   ? "selected" : "" %>>Volunteer</option>
        <option value="sports"    <%= event.category === "sports"      ? "selected" : "" %>>Sports</option>
        <option value="arts"      <%= event.category === "arts"        ? "selected" : "" %>>Arts</option>
      </select>
    </div>

    <div class="grid gap-1.5">
      <label for="capacity" class="text-sm font-medium">Capacity <span class="text-slate-400 font-normal">(optional — leave blank to remove limit)</span></label>
      <input
        id="capacity"
        name="capacity"
        type="number"
        min="1"
        step="1"
        value="<%= event.capacity != null ? event.capacity : "" %>"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      />
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div class="grid gap-1.5">
        <label for="startDatetime" class="text-sm font-medium">Start Date & Time <span class="text-red-500">*</span></label>
        <input
          id="startDatetime"
          name="startDatetime"
          type="datetime-local"
          required
          value="<%= event.startDatetime.toISOString().slice(0, 16) %>"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
        />
      </div>
      <div class="grid gap-1.5">
        <label for="endDatetime" class="text-sm font-medium">End Date & Time <span class="text-red-500">*</span></label>
        <input
          id="endDatetime"
          name="endDatetime"
          type="datetime-local"
          required
          value="<%= event.endDatetime.toISOString().slice(0, 16) %>"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
        />
      </div>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <button
        type="submit"
        class="px-4 py-2.5 rounded-lg bg-blue-600 text-white font-medium cursor-pointer hover:bg-blue-700 transition-colors"
      >
        Save Changes
      </button>
      <a href="/events/<%= event.id %>" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
    </div>

  </form>
</section>

</div>

<% } %>
