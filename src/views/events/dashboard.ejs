<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-1">Organizer Dashboard</h1>
  <p class="text-slate-500">Track events by status and attendee counts.</p>
</section>

<div class="grid gap-5 lg:grid-cols-3 items-start">
  <% const statusGroups = [
      { key: 'published', label: 'Published', color: 'text-green-700', bg: 'bg-green-50/50', border: 'border-green-100' },
      { key: 'draft', label: 'Drafts', color: 'text-slate-700', bg: 'bg-slate-50/50', border: 'border-slate-100' },
      { key: 'archived', label: 'Past & Cancelled', color: 'text-rose-700', bg: 'bg-rose-50/50', border: 'border-rose-100' }
  ]; %>

  <% statusGroups.forEach(group => { %>
    <section 
      class="p-5 border <%= group.border %> rounded-2xl <%= group.bg %> shadow-sm transition-all min-h-[160px] flex flex-col"
      <% if (group.key === 'archived') { %> x-data="{ expanded: false }" <% } %>
    >
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold <%= group.color %> uppercase tracking-tight">
          <%= group.label %> 
          <span class="ml-1 text-sm font-normal opacity-60">(<%= groups[group.key].length %>)</span>
        </h2>
        
        <% if (group.key === 'archived' && groups[group.key].length > 0) { %>
          <button @click="expanded = !expanded" class="text-xs font-bold text-rose-600 hover:underline">
            <span x-text="expanded ? 'Collapse' : 'Show All'"></span>
          </button>
        <% } %>
      </div>
      
      <div <% if (group.key === 'archived') { %> x-show="expanded" x-collapse x-cloak <% } %>>
        <% if (groups[group.key].length === 0) { %>
          <p class="text-sm text-slate-400 italic py-4">No events in this category.</p>
        <% } else { %>
          <ul class="space-y-3">
            <% groups[group.key].forEach((event) => { %>
              <%- include('./partials/dashboard-item', { event: event }) %>
            <% }) %>
          </ul>
        <% } %>
      </div>

      <% if (group.key === 'archived') { %>
        <div x-show="!expanded" class="text-center py-2">
          <p class="text-xs text-rose-400 font-medium">Archived events are hidden by default.</p>
        </div>
      <% } %>
    </section>
  <% }) %>
</div>