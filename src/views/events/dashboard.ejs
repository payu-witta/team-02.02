<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-1">Organizer Dashboard</h1>
  <p class="text-slate-500">Track events by status and attendee counts.</p>
</section>

<div class="grid gap-5 md:grid-cols-3">
  <% const statusGroups = [
      { key: 'published', label: 'Published', color: 'text-green-700' },
      { key: 'draft', label: 'Draft', color: 'text-slate-700' },
      { key: 'archived', label: 'Archived', color: 'text-red-700' }
  ]; %>

  <% statusGroups.forEach(group => { %>
    <section class="p-5 border border-slate-200 rounded-2xl bg-white shadow-lg">
      <h2 class="text-lg font-semibold mb-3 <%= group.color %>"><%= group.label %></h2>
      
      <% if (groups[group.key].length === 0) { %>
        <p class="text-sm text-slate-500 italic">No <%= group.key %> events.</p>
      <% } else { %>
        <ul class="space-y-3">
          <% groups[group.key].forEach((event) => { %>
            <%- include('./partials/dashboard-item', { event: event }) %>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% }) %>
</div>
