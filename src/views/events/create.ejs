<div id="create-form-section">

<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-1">Create Event</h1>
  <p class="text-slate-500">Fill out the form below to create a new draft event.</p>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<section class="max-w-2xl p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
  <form
    class="grid gap-4"
    method="post"
    action="/events"
    hx-post="/events"
    hx-target="#create-form-section"
    hx-swap="outerHTML"
  >

    <div class="grid gap-1.5">
      <label for="title" class="text-sm font-medium">Title <span class="text-red-500">*</span></label>
      <input
        id="title"
        name="title"
        type="text"
        required
        maxlength="100"
        value="<%= formValues?.title ?? '' %>"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      />
    </div>

    <div class="grid gap-1.5" x-data="{ descLen: 0 }">
      <div class="flex items-baseline justify-between">
        <label for="description" class="text-sm font-medium">Description <span class="text-red-500">*</span></label>
        <span class="text-xs" :class="descLen >= 1000 ? 'text-red-500 font-medium' : 'text-slate-400'" x-text="descLen + ' / 1000'"></span>
      </div>
      <textarea
        id="description"
        name="description"
        rows="4"
        required
        maxlength="1000"
        x-on:input="descLen = $el.value.length"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500 resize-y"
      ><%= formValues?.description ?? '' %></textarea>
    </div>

    <div class="grid gap-1.5">
      <label for="location" class="text-sm font-medium">Location <span class="text-red-500">*</span></label>
      <input
        id="location"
        name="location"
        type="text"
        required
        value="<%= formValues?.location ?? '' %>"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      />
    </div>

    <div class="grid gap-1.5">
      <label for="category" class="text-sm font-medium">Category <span class="text-red-500">*</span></label>
      <select
        id="category"
        name="category"
        required
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      >
        <option value="" disabled <%= !formValues?.category ? 'selected' : '' %>>Select a category</option>
        <option value="social"      <%= formValues?.category === 'social'      ? 'selected' : '' %>>Social</option>
        <option value="educational" <%= formValues?.category === 'educational' ? 'selected' : '' %>>Educational</option>
        <option value="volunteer"   <%= formValues?.category === 'volunteer'   ? 'selected' : '' %>>Volunteer</option>
        <option value="sports"      <%= formValues?.category === 'sports'      ? 'selected' : '' %>>Sports</option>
        <option value="arts"        <%= formValues?.category === 'arts'        ? 'selected' : '' %>>Arts</option>
      </select>
    </div>

    <div class="grid gap-1.5">
      <label for="capacity" class="text-sm font-medium">Capacity <span class="text-slate-400 font-normal">(optional — leave blank for no limit)</span></label>
      <input
        id="capacity"
        name="capacity"
        type="number"
        min="1"
        step="1"
        value="<%= formValues?.capacity ?? '' %>"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      />
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div class="grid gap-1.5">
        <label for="startDatetime" class="text-sm font-medium">Start Date & Time <span class="text-red-500">*</span></label>
        <input
          id="startDatetime"
          name="startDatetime"
          type="datetime-local"
          required
          value="<%= formValues?.startDatetime ?? '' %>"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
        />
      </div>
      <div class="grid gap-1.5">
        <label for="endDatetime" class="text-sm font-medium">End Date & Time <span class="text-red-500">*</span></label>
        <input
          id="endDatetime"
          name="endDatetime"
          type="datetime-local"
          required
          value="<%= formValues?.endDatetime ?? '' %>"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
        />
      </div>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <button
        type="submit"
        class="px-4 py-2.5 rounded-lg bg-blue-600 text-white font-medium cursor-pointer hover:bg-blue-700 transition-colors"
      >
        Create Event
      </button>
      <a href="/home" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
    </div>

  </form>
</section>

</div>
