<%
  const statusColors = {
  draft:     "bg-slate-100 text-slate-600 border-slate-200",
  published: "bg-green-100 text-green-800 border-green-200 shadow-sm shadow-green-100",
  cancelled: "bg-rose-100 text-rose-800 border-rose-200",
  past:      "bg-slate-200 text-slate-600 border-slate-300",
};

  const canManage = session.authenticatedUser && 
    (session.authenticatedUser.role === 'admin' || 
     session.authenticatedUser.userId === event.organizerId);
%>

<section id="event-header-<%= event.id %>" class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span 
            x-data="{ show: false }" 
            x-init="setTimeout(() => show = true, 50)"
            :class="show ? 'scale-100 opacity-100' : 'scale-90 opacity-0'"
            class="transform transition-all duration-500 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full border <%= statusColors[event.status] %>"
          >
          <%= event.status %>
        </span>
        <span class="text-xs text-slate-400 capitalize ml-2"><%= event.category %></span>
      </div>
      <h1 class="text-3xl font-bold text-slate-900 mb-1"><%= event.title %></h1>
      <p class="text-slate-500"><%= event.location %></p>
    </div>

    <div class="flex items-center gap-2">
      <% if (canManage) { %>
        <% if (event.status === 'draft') { %>
          <button 
            hx-post="/events/<%= event.id %>/publish"
            hx-target="#event-header-<%= event.id %>"
            hx-swap="outerHTML"
            class="px-5 py-2 rounded-xl bg-green-600 text-white text-sm font-bold hover:bg-green-700 transition-all active:scale-95 shadow-md shadow-green-200">
            Publish Draft
          </button>
        <% } %>

        <% if (event.status === 'published') { %>
          <button 
            hx-post="/events/<%= event.id %>/cancel"
            hx-target="#event-header-<%= event.id %>"
            hx-swap="outerHTML"
            hx-confirm="Are you sure you want to cancel this event?"
            class="px-5 py-2 rounded-xl bg-white border border-rose-200 text-rose-600 text-sm font-bold hover:bg-rose-50 transition-all active:scale-95">
            Cancel Event
          </button>
        <% } %>

        <a href="/events/<%= event.id %>/edit"
           class="px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 text-sm font-medium hover:bg-slate-50 no-underline transition-colors">
          Edit Event
        </a>
      <% } %>
    </div>
    
  </div>
</section>