<%
  const statusColors = {
    draft:     "bg-slate-100 text-slate-600 border-slate-200",
    published: "bg-green-50 text-green-700 border-green-200",
    cancelled: "bg-red-50 text-red-700 border-red-200",
    past:      "bg-slate-100 text-slate-500 border-slate-200",
  };
  
  const canManage = session.authenticatedUser && 
    (session.authenticatedUser.role === 'admin' || 
    session.authenticatedUser.userId === event.organizerId);
%>

<div id="event-controls-<%= event.id %>" class="flex items-center gap-3">
  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= statusColors[event.status] %>">
    <%= event.status %>
  </span>

  <% if (canManage) { %>
    <div class="flex gap-2">
      <% if (event.status === 'draft') { %>
        <button 
          hx-post="/events/<%= event.id %>/publish"
          hx-target="#event-controls-<%= event.id %>"
          hx-swap="outerHTML"
          class="text-xs font-bold px-3 py-1 bg-green-600 text-white rounded-md hover:bg-green-700">
          Publish
        </button>
      <% } %>

      <% if (event.status === 'published') { %>
        <button 
          hx-post="/events/<%= event.id %>/cancel"
          hx-target="#event-controls-<%= event.id %>"
          hx-swap="outerHTML"
          hx-confirm="Are you sure you want to cancel this event?"
          class="text-xs font-bold px-3 py-1 bg-white border border-red-200 text-red-600 rounded-md hover:bg-red-50">
          Cancel
        </button>
      <% } %>
    </div>
  <% } %>
</div>