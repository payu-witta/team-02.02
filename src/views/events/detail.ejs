<%
  const statusColors = {
    draft:     "bg-slate-100 text-slate-600 border-slate-200",
    published: "bg-green-50 text-green-700 border-green-200",
    cancelled: "bg-red-50 text-red-700 border-red-200",
    past:      "bg-slate-100 text-slate-500 border-slate-200",
  };
  const statusLabel = {
    draft:     "Draft",
    published: "Published",
    cancelled: "Cancelled",
    past:      "Past",
  };
  const canEdit =
    session.authenticatedUser &&
    (session.authenticatedUser.role === "admin" ||
      (session.authenticatedUser.role === "staff" &&
        session.authenticatedUser.userId === event.organizerId));
%>

<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= statusColors[event.status] %>">
          <%= statusLabel[event.status] %>
        </span>
        <span class="text-xs text-slate-400 capitalize"><%= event.category %></span>
      </div>
      <h1 class="text-3xl font-bold text-slate-900 mb-1"><%= event.title %></h1>
      <p class="text-slate-500"><%= event.location %></p>
    </div>
    <% if (canEdit) { %>
      <a
        href="/events/<%= event.id %>/edit"
        class="px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 text-sm font-medium hover:bg-slate-50 no-underline"
      >
        Edit Event
      </a>
    <% } %>
  </div>
</section>

<div class="grid gap-5 max-w-2xl">

  <section class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
    <h2 class="text-base font-semibold text-slate-700 mb-3">About</h2>
    <p class="text-slate-700 whitespace-pre-line"><%= event.description %></p>
  </section>

  <section class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
    <h2 class="text-base font-semibold text-slate-700 mb-3">Details</h2>
    <dl class="grid gap-3 text-sm">
      <div class="grid grid-cols-[120px_1fr] gap-2">
        <dt class="text-slate-500 font-medium">Starts</dt>
        <dd class="text-slate-800"><%= event.startDatetime.toLocaleString() %></dd>
      </div>
      <div class="grid grid-cols-[120px_1fr] gap-2">
        <dt class="text-slate-500 font-medium">Ends</dt>
        <dd class="text-slate-800"><%= event.endDatetime.toLocaleString() %></dd>
      </div>
      <div class="grid grid-cols-[120px_1fr] gap-2">
        <dt class="text-slate-500 font-medium">Location</dt>
        <dd class="text-slate-800"><%= event.location %></dd>
      </div>
      <div class="grid grid-cols-[120px_1fr] gap-2">
        <dt class="text-slate-500 font-medium">Category</dt>
        <dd class="text-slate-800 capitalize"><%= event.category %></dd>
      </div>
      <div class="grid grid-cols-[120px_1fr] gap-2">
        <dt class="text-slate-500 font-medium">Capacity</dt>
        <dd class="text-slate-800">
          <% if (event.capacity != null) { %>
            <%= event.capacity %> spots
          <% } else { %>
            No limit
          <% } %>
        </dd>
      </div>
    </dl>
  </section>

</div>
