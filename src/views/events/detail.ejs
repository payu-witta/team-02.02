<h1><%= event.title %></h1>

<p><strong>Description:</strong> <%= event.description %></p>
<p><strong>Location:</strong> <%= event.location %></p>
<p><strong>Category:</strong> <%= event.category %></p>
<p><strong>Status:</strong> <%= event.status %></p>
<p><strong>Starts:</strong> <%= event.startDatetime %></p>
<p><strong>Ends:</strong> <%= event.endDatetime %></p>
<p><strong>Attendee count:</strong> <%= attendeeCount %></p>

<% if (currentUserRsvp) { %>
  <p><strong>Your RSVP:</strong> <%= currentUserRsvp.status %></p>
<% } %>

<% if (canEdit) { %>
  <p>You can edit this event.</p>
<% } %>

<% if (showRsvpButton) { %>
  <p>RSVP button will go here in a later sprint.</p>
<% } %>