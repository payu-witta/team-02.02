<div id="event-list-page">

  <%# Search input - Feature 10 %>
  <form
    x-data="{ query: '<%= typeof query !== 'undefined' ? query : '' %>' }"
    action="/events/search"
    method="GET"
    hx-get="/events/search"
    hx-trigger="input changed delay: 300ms from: find input[name='query'],submit"
    hx-target="#event-list-page"
    hx-select="#event-list-page"
    hx-swap="outerHTML"
    hx-push-url="true"
    class="relative mb-6"
  >
    <input
      type="text"
      name="query"
      x-model="query"
      placeholder="Search events..."
      class="w-full px-4 py-3 pr-12 rounded-xl border border-slate-300 bg-white shadow-md text-base focus:outline-none focus:ring-2 focus:ring-blue-500"
    />

    <button
      type="button"
      x-show="query.length > 0"
      x-transition
      @click="
      query = '';
      htmx.ajax('GET', '/events', {
        target: '#event-list-page',
        swap: 'outerHTML',
        headers: { 'HX-Push-Url': '/events' }
      })
      "      
      class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 z-10"
      aria-label="Clear search"
    >
      ✕
    </button>
  </form>

  <%# Filter bar — Feature 6 %>  
  <form
    x-data="{
      category: '<%= category || '' %>',
      timeframe: '<%= timeframe || 'upcoming' %>',
      get hasFilters() {
        return this.category !== '' || this.timeframe !== 'upcoming'
      }
    }"
    action="/events"
    method="GET"
    hx-get="/events"
    hx-target="#event-list-page"
    hx-swap="outerHTML"
    hx-push-url="true"
    class="flex flex-wrap items-center gap-3 mb-6 p-3 rounded-xl border border-slate-200 bg-white shadow-sm"
  >
  <select
    name="category"
    x-model="category"
    hx-trigger="change"
    class="px-3 py-2 rounded-lg border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
  >
      <option value="">All categories</option>
      <option value="social"      <%= category === 'social'      ? 'selected' : '' %>>Social</option>
      <option value="educational" <%= category === 'educational' ? 'selected' : '' %>>Educational</option>
      <option value="volunteer"   <%= category === 'volunteer'   ? 'selected' : '' %>>Volunteer</option>
      <option value="sports"      <%= category === 'sports'      ? 'selected' : '' %>>Sports</option>
      <option value="arts"        <%= category === 'arts'        ? 'selected' : '' %>>Arts</option>
    </select>

    <select
      name="timeframe"
      x-model="timeframe"
      hx-trigger="change"
      class="px-3 py-2 rounded-lg border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
    >
      <option value="upcoming"     <%= timeframe === 'upcoming'     ? 'selected' : '' %>>All upcoming</option>
      <option value="this_week"    <%= timeframe === 'this_week'    ? 'selected' : '' %>>This week</option>
      <option value="this_weekend" <%= timeframe === 'this_weekend' ? 'selected' : '' %>>This weekend</option>
    </select>

    <a 
      x-show="hasFilters"
      x-transition
      href="/events"
      class="ml-auto px-3 py-2 rounded-lg boarder boarder-red-200 text-sm font-medium text-red-600 hover:bg-red-50"
      >
      Clear filters
    </a>
  
    <noscript>
      <button type="submit" class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium">Apply</button>
    </noscript>
  </form>

  <% if (!events || events.length === 0) { %>
    <p>No events found.</p>
  <% } else { %>
    <% events.forEach((event) => { %>
      <article class="mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
        <h2><%= event.title %></h2>
        <p><strong>Category:</strong> <%= event.category %></p>
        <p><strong>Location:</strong> <%= event.location %></p>
        <p><%= event.description %></p>
      </article>
    <% }) %>
  <% } %>

</div>